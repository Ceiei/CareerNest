{
  "name": "autofill-copilot",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/start-demo.mjs",
    "demo:setup": "node scripts/setup-demo.mjs",
    "doctor": "node scripts/python-task.mjs scripts/doctor.py",
    "demo:pack": "node scripts/python-task.mjs scripts/package-demo.py",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "dev": "wxt",
    "build": "npm run schema && wxt build",
    "schema": "wxt prepare && vite-node scripts/export-workspace-schema.ts",
    "desktop:build": "npm run schema && .venv/bin/python desktop/build.py",
    "service": "node scripts/python-task.mjs -m local_service.run",
    "test:service": "node scripts/python-task.mjs -m unittest local_service.test_app local_service.test_demo -v",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "mammoth": "^1.12.2",
    "pdfjs-dist": "^6.3.289",
    "wxt": "^0.21.4"
  },
  "devDependencies": {
    "@types/node": "22.15.21",
    "electron": "44.3.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
